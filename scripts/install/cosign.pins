# cosign release that install.sh downloads to verify the TransTeira image on the server, with the
# SHA-256 of its Linux binaries, copied from cosign_checksums.txt of that GitHub release
# (https://github.com/sigstore/cosign/releases). scripts/install/build.sh bakes these values into
# install.sh; the installer refuses a download with another checksum. Keep COSIGN_VERSION equal to
# the cosign version of the Makefile (COSIGN): scripts/install/install_test.go checks it.
# Format: KEY=VALUE, no quoting, comments on their own lines.
COSIGN_VERSION=v3.1.4
COSIGN_SHA256_LINUX_AMD64=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa
COSIGN_SHA256_LINUX_ARM64=ade83b7aac62e131cacfe96d958948b2150cc9efec46a570a2649b8e27dedad2
