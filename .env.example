# TransTeira configuration (generated from internal/config, do not edit by hand).
# Copy this file to .env and adjust the values. Durations use Go syntax (15m, 4h, 168h).
# Tenant-specific settings (branding, SMTP, IP ranges...) live in the database and are
# managed from the administration, not here.

# ============================================================================
# Database
# ============================================================================

# Database engine: sqlite (default, single instance) or postgres.
# Default: sqlite
# TT_DB_DRIVER=sqlite

# Database connection string. For sqlite, the path of the database file
# (default shown). Required for postgres, e.g.
# postgres://transteira:password@postgres:5432/transteira?sslmode=disable.
# Mutually exclusive with TT_DB_DSN_FILE.
# Default: /var/lib/transteira/db/transteira.db
# Secret: never commit a real value.
# TT_DB_DSN=/var/lib/transteira/db/transteira.db

# Path of a file (e.g. a Docker secret) containing the database connection
# string. Preferred over TT_DB_DSN for postgres since it keeps the password
# out of the environment.
# TT_DB_DSN_FILE=

# PostgreSQL only (refused with sqlite): connection string of the owner role,
# used only to apply migrations and grant DML rights to the runtime role.
# Needed only by the process that applies migrations (transteira migrate, or
# serve when it migrates at startup); migrations fail with a clear error when
# it is absent. Prefer a one-shot migrate container so that the long-running
# server never holds the owner credentials. TT_DB_DSN must use a different
# role that owns no table, is not superuser and has no BYPASSRLS, so that it
# cannot disable row-level security. Mutually exclusive with
# TT_DB_MIGRATE_DSN_FILE.
# Secret: never commit a real value.
# TT_DB_MIGRATE_DSN=

# Path of a file (e.g. a Docker secret) containing the migration connection
# string (alternative to TT_DB_MIGRATE_DSN).
# TT_DB_MIGRATE_DSN_FILE=

# ============================================================================
# Storage
# ============================================================================

# Absolute path of the volume holding the encrypted uploaded files (one
# sub-directory per tenant).
# Default: /var/lib/transteira/data
# TT_DATA_DIR=/var/lib/transteira/data

# Absolute path of the volume receiving the regular database backups (VACUUM
# INTO or pg_dump).
# Default: /var/lib/transteira/backups
# TT_BACKUP_DIR=/var/lib/transteira/backups

# Absolute path of the directory holding the security log read by fail2ban or
# CrowdSec.
# Default: /var/log/transteira
# TT_LOG_DIR=/var/log/transteira

# ============================================================================
# Encryption
# ============================================================================

# Absolute path of the file containing the master key (e.g. a Docker secret).
# It must NOT be located inside the data, backup or log directories, nor in
# the folder of the SQLite database. Keep a copy of the key in a password
# vault outside the VM: without it, files and backups cannot be decrypted. See
# docs/operations/master-key.md.
# Required.
TT_MASTER_KEY_FILE=/run/secrets/transteira_master_key

# Absolute path of the new master key during a rotation: set it and restart,
# run rotate-master-key, then move the new key to TT_MASTER_KEY_FILE and
# remove this variable. Same location rules as TT_MASTER_KEY_FILE, and it must
# differ from it. See docs/operations/master-key.md.
# TT_MASTER_KEY_NEW_FILE=

# ============================================================================
# Network
# ============================================================================

# Comma-separated list of IP addresses or CIDR prefixes of the trusted reverse
# proxies. X-Forwarded-For / X-Real-IP are only honored for requests coming
# from these addresses. List the reverse proxies by their exact IP address:
# every host inside a trusted range can forge the client IP. Startup fails on
# an IPv4 prefix shorter than /8, an IPv6 prefix shorter than /32, or prefixes
# that together cover the whole IPv4 or IPv6 space; a warning is logged for
# prefixes wider than /24 (IPv4) or /64 (IPv6). A trusted proxy must never sit
# inside a tenant's internal IP range. A request from a trusted proxy without
# a valid X-Forwarded-For / X-Real-IP is treated as coming from an unknown
# client (fail closed). Empty means no proxy is trusted.
# TT_TRUSTED_PROXIES=

# Address (host:port) the HTTP server listens on inside the container.
# Default: :8080
# TT_LISTEN_ADDR=:8080

# Comma-separated list of host names from which the administration is
# reachable. Empty means every tenant host.
# TT_ADMIN_HOSTS=

# ============================================================================
# Antivirus
# ============================================================================

# Address of the clamd daemon: host:port, or unix:/absolute/path for a Unix
# socket.
# Default: clamav:3310
# TT_CLAMAV_ADDR=clamav:3310

# Largest file size, in bytes, sent to clamd for analysis (between 1048576 and
# 4294967295; default 2 GiB). Larger files are accepted without analysis, and
# the sender and recipients are told so. Align clamd's StreamMaxLength,
# MaxScanSize and MaxFileSize on this value: a file clamd refuses as too large
# is treated the same way.
# Default: 2147483648
# TT_CLAMAV_MAX_SCAN_BYTES=2147483648

# Time limit of the analysis of one file by clamd (Go duration, between 10s
# and 2h). A stalled exchange is also cut after one minute without progress. A
# timed-out analysis counts against the file and is retried later; the file
# stays unavailable meanwhile, and after 3 timeouts it is withheld for good
# (scan_error).
# Default: 10m
# TT_CLAMAV_TIMEOUT=10m

# Number of antivirus workers (between 1 and 16). Each worker analyzes one
# file at a time; a transfer is never analyzed by two workers at once. Keep it
# at or below clamd's MaxThreads (10 by default): otherwise scans queued by
# clamd may time out and count against their files.
# Default: 2
# TT_SCAN_WORKERS=2

# ============================================================================
# Mail
# ============================================================================

# Time limit of one SMTP delivery attempt, from connection to the end of the
# message (Go duration, between 1s and 5m). Mails are sent in the background
# and retried once, so a slow server never delays a request.
# Default: 30s
# TT_SMTP_TIMEOUT=30s

# Capacity of the in-memory queue of mails waiting to be sent (between 1 and
# 100000). When it is full, requests that send a mail (verification codes,
# invitations) are answered 429 Too Many Requests.
# Default: 1000
# TT_MAIL_QUEUE_SIZE=1000

# ============================================================================
# Logging
# ============================================================================

# Application log level: debug, info, warn or error.
# Default: info
# TT_LOG_LEVEL=info

# ============================================================================
# Operations
# ============================================================================

# Start in maintenance mode (true/false/1/0): new deposits are refused, the
# health check keeps answering.
# Default: false
# TT_MAINTENANCE=false

# Serve the interactive API documentation to anonymous visitors
# (true/false/1/0). By default it is reserved to authenticated admins.
# Default: false
# TT_API_DOCS_PUBLIC=false

# Optional token (16 to 128 characters) required to create the first super
# admin, protecting the window between deployment and setup. Mutually
# exclusive with TT_SETUP_TOKEN_FILE.
# Secret: never commit a real value.
# TT_SETUP_TOKEN=

# Path of a file containing the setup token (alternative to TT_SETUP_TOKEN).
# TT_SETUP_TOKEN_FILE=

# ============================================================================
# Uploads
# ============================================================================

# Time after which an unfinished resumable upload is discarded (Go duration,
# between 1h and 168h).
# Default: 24h
# TT_UPLOAD_TTL=24h

# Longest life of an unfinished upload after the creation of its transfer,
# whatever its activity, so that an upload kept alive by tiny requests cannot
# hold the storage quota forever (Go duration, between 24h and 2160h, and at
# least TT_UPLOAD_TTL).
# Default: 168h
# TT_UPLOAD_MAX_AGE=168h

# Lifetime of a deposit session after e-mail verification (Go duration,
# between 15m and 24h).
# Default: 4h
# TT_DEPOSIT_SESSION_TTL=4h

# Grace period before a delete-after-first-download transfer is erased, so
# that an interrupted download can be resumed (Go duration, between 0s and
# 24h).
# Default: 15m
# TT_DELETE_AFTER_DOWNLOAD_GRACE=15m

# Longest wait between two reads of an upload request body before the server
# cuts the connection; reset by every read, so that slow but active uploads
# continue (Go duration, between 5s and 10m).
# Default: 60s
# TT_UPLOAD_IDLE_TIMEOUT=60s

# Largest number of recipients of one transfer (anti-spam ceiling, between 1
# and 100).
# Default: 50
# TT_MAX_RECIPIENTS=50

# Largest number of unfinished (not yet finalized) transfers one internal
# sender may have at once, so that abandoned transfers cannot hold the storage
# quota (between 1 and 1000). Invited external senders are limited to 3.
# Default: 10
# TT_MAX_OPEN_TRANSFERS=10

# ============================================================================
# Downloads
# ============================================================================

# Longest wait for a client to accept the next part of a download before the
# server cuts the connection; reset by every write, so that slow but active
# downloads continue (Go duration, between 5s and 10m).
# Default: 60s
# TT_DOWNLOAD_IDLE_TIMEOUT=60s
