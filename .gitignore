# Environment and secrets
.env
.env.*
!.env.example
secrets/
*.key
*.pem
*.p12
master.key*
*master_key*
gitleaks-report*

# Runtime data (never commit uploaded files, databases, backups or logs)
/data/
/var/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backups/
*.log
logs/

# Build and test artefacts
/bin/
/dist/
coverage.out
.gencheck.*
coverage.html
*.test
*.prof
web/dist/*
!web/dist/.gitkeep
web/coverage/
# Integrated help generated from docs/user by web/scripts/build-help.mjs
web/src/help/generated/
web/node_modules/
test/e2e/node_modules/
test/e2e/test-results/
test/e2e/playwright-report/
# End-to-end run directory: generated Caddyfile, seeded credentials, storage states, server log
test/e2e/.run/
# Machine-wide lock of the end-to-end runs (test/e2e/scripts/lock.mjs)
test/e2e/.run.lock*

# Go fuzzing cache stays local; committed regression inputs live in testdata/fuzz
/fuzz/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Claude Code local settings
.claude/settings.local.json

# Locally built binaries
/transteira
/transteira.exe
*.exe
