# Normalise every text file to LF, including on Windows checkouts:
# shell scripts, git hooks, golden files and the security log format depend on it.
* text=auto eol=lf

*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff2 binary

# Vendored third-party bundle: kept byte for byte (its SHA-256 is recorded in web/apidocs/README.md).
web/apidocs/scalar.js -text -diff linguist-vendored
