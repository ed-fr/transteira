# TransTeira deployment settings (deploy/docker-compose.yml).
#
# Copy to deploy/.env (never commit it) and adjust. This file serves twice:
#   - docker compose reads it to fill the ${...} of the compose files
#     (TRANSTEIRA_IMAGE, PROXY_NETWORK, MASTER_KEY_FILE, SECRETS_DIR...);
#   - the transteira container receives it as its environment (env_file).
#
# Only the settings that matter for a Docker deployment are listed here. Every
# TT_* variable, with its default and its limits, is documented in the
# .env.example at the root of the repository; copy any of them here as needed.
# Do not set TT_DATA_DIR, TT_BACKUP_DIR, TT_LOG_DIR, TT_LISTEN_ADDR,
# TT_CLAMAV_ADDR, TT_MASTER_KEY_FILE or TT_DB_*: the compose files fix them to
# match the volumes, secrets and services.

# ============================================================================
# Compose
# ============================================================================

# Image of TransTeira. `make docker` builds transteira:local from the
# repository; in production, pin a released version (never "latest").
TRANSTEIRA_IMAGE=transteira:local

# External Docker network shared with the reverse proxy (created once with
# `docker network create --subnet 172.30.0.0/24 proxy`; the proxy compose file joins it too).
PROXY_NETWORK=proxy

# Host file holding the master key (32 random bytes, base64), outside every
# Docker volume, readable by UID 10001, mode 0400 or 0600. Keep a copy in a
# password vault outside the VM: without it, files and backups are lost.
# See docs/operations/master-key.md; deploy/init-secrets.sh creates it.
MASTER_KEY_FILE=./secrets/master_key

# Fixed subnets of the "internal" network (TransTeira <-> clamd) and, with the
# PostgreSQL overlay, of the "db" network (TransTeira <-> PostgreSQL). Pick
# subnets that overlap neither your LAN, nor another Docker network, nor the
# internal IP range of a tenant. If you change them, change
# TT_SMTP_DENY_NETWORKS below too.
INTERNAL_SUBNET=172.31.10.0/24
DB_SUBNET=172.31.11.0/24

# PostgreSQL overlay only: folder of the database secret files (see
# docker-compose.postgres.yml and deploy/init-secrets.sh --postgres).
SECRETS_DIR=./secrets

# Uncomment to apply the PostgreSQL overlay with a plain `docker compose`
# (run from deploy/; use ";" instead of ":" on Windows).
# COMPOSE_FILE=docker-compose.yml:docker-compose.postgres.yml

# ============================================================================
# TransTeira (see the root .env.example for every variable)
# ============================================================================

# Dedicated host name(s) of the administration, comma-separated, never a tenant
# FQDN. The reverse proxy must serve it with TLS, like the tenant FQDNs.
# Required.
TT_ADMIN_HOSTS=admin.transfer.example.com

# IP address of the reverse proxy as TransTeira sees it: its address on the
# PROXY_NETWORK network. X-Forwarded-For / X-Real-IP are honored only from
# this address; empty, every client is seen as the proxy and the IP filtering
# of the tenants cannot work. Give the proxy container a fixed address on the
# network (see integrations/reverse-proxy/) and list it exactly: every host
# inside a trusted range can forge the client IP. Find the current address
# with:
#   docker network inspect proxy --format '{{range .Containers}}{{.Name}} {{.IPv4Address}}{{"\n"}}{{end}}'
TT_TRUSTED_PROXIES=172.30.0.10

# Networks that the SMTP server of a tenant (typed by an admin) may never
# resolve to (protection against server-side request forgery). The value
# REPLACES the built-in default, so it repeats it (loopback, link-local and
# cloud metadata addresses, 0.0.0.0/8, ::/96) and appends the three Docker
# networks of this deployment: the proxy subnet (172.30.0.0/24, see
# PROXY_NETWORK), INTERNAL_SUBNET (clamd) and DB_SUBNET (PostgreSQL). A tenant
# SMTP relay container must therefore sit on a network of its own, shared with
# TransTeira (docs/install/smtp.md). The system SMTP server is not concerned.
TT_SMTP_DENY_NETWORKS=127.0.0.0/8,::1/128,169.254.0.0/16,fe80::/10,fd00:ec2::254/128,100.100.100.200/32,0.0.0.0/8,::/96,172.30.0.0/24,172.31.10.0/24,172.31.11.0/24

# Monitoring: bearer token (32 to 512 characters) protecting /metrics and
# /status, served on the admin host. Unset, both answer 404. Prefer a file
# mounted as a Docker secret; changed by restarting. Optional CIDR list of the
# monitoring servers allowed to read them. See docs/operations/supervision.md.
# TT_METRICS_TOKEN_FILE=/run/secrets/metrics_token
# TT_METRICS_ALLOWED_IPS=192.0.2.10/32

# Application log level: debug, info, warn or error.
# TT_LOG_LEVEL=info

# Optional setup token for the first super admin. Unset, TransTeira prints a
# random one in `docker compose logs transteira` while no admin exists.
# TT_SETUP_TOKEN=

# System mail (disk space alert to the super admins), distinct from the SMTP
# servers of the tenants, which are set in the administration. Empty: no system
# mail, the alert only shows in the administration and the logs. For an
# authenticated server, mount the password as a Docker secret and set
# TT_SYSTEM_SMTP_PASSWORD_FILE (see the root .env.example).
# TT_SYSTEM_SMTP_HOST=smtp-relay
# TT_SYSTEM_SMTP_PORT=25
# TT_SYSTEM_SMTP_SECURITY=none
# TT_SYSTEM_SMTP_FROM=transteira@example.com

# Antivirus: largest file sent to clamd (bytes, default 2 GiB). If you change
# it, align StreamMaxLength, MaxScanSize and MaxFileSize in
# deploy/clamav/clamd.conf, and the size of the clamd spool tmpfs and the
# clamav mem_limit in docker-compose.yml.
# TT_CLAMAV_MAX_SCAN_BYTES=2147483648
# TT_CLAMAV_TIMEOUT=10m

# Number of files scanned at the same time. 1 in this deployment (the compose
# file defaults to it too): clamd writes each decrypted stream to its spool, a
# tmpfs in memory sized for ONE stream of TT_CLAMAV_MAX_SCAN_BYTES, so that the
# plaintext never touches a disk (docs/operations/antivirus.md). Two scans at
# once could fill it, and the second file would fail its attempt. To raise it,
# grow that tmpfs (N x 2 GiB + 256m) and the clamav mem_limit accordingly,
# and stay at or below clamd's MaxThreads (10).
TT_SCAN_WORKERS=1

# Nightly database copy (UTC) and number of copies kept. With PostgreSQL, the
# db-backup service of the overlay uses the same two values for pg_dump.
# TT_BACKUP_TIME=02:30
# TT_BACKUP_KEEP=7
