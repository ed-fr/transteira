<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Your verification code for {{.TenantName}}</title>
</head>
<body style="margin:0;padding:24px;background-color:#ffffff;color:#1a1a1a;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.5;">
<div role="main" style="max-width:560px;margin:0 auto;">
<h1 style="font-size:20px;margin:0 0 16px;">{{.TenantName}}</h1>
<p>Hello,</p>
<p>Your verification code is:</p>
<p style="font-family:'Courier New',Courier,monospace;font-size:28px;font-weight:bold;letter-spacing:4px;margin:16px 0;">{{.Code}}</p>
<p>It is valid for {{.ValidityMinutes}} minutes. Enter it on the page where you requested it.</p>
<p>{{t "mail.footer.ignore"}}</p>
<hr style="border:0;border-top:1px solid #767676;margin:24px 0 16px;">
<p style="font-size:14px;color:#4a4a4a;">{{t "mail.footer.automated" "tenant" .TenantName}}</p>
</div>
</body>
</html>
