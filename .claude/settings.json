      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Read(./secrets/**)",
      "Read(./**/master.key)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push:*--no-verify*)",
      "Bash(git commit:*--no-verify*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)"
    ]
  }
}
