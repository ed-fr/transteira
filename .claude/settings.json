      "PowerShell(go vet:*)",
      "PowerShell(go run:*)",
      "PowerShell(go generate:*)",
      "PowerShell(go mod:*)",
      "PowerShell(go list:*)",
      "PowerShell(gofmt:*)",
      "PowerShell(golangci-lint:*)",
      "PowerShell(govulncheck:*)",
      "PowerShell(make:*)",
      "PowerShell(docker compose:*)",
      "PowerShell(docker build:*)",
      "PowerShell(docker ps:*)",
      "PowerShell(docker logs:*)",
      "PowerShell(npm run:*)",
      "PowerShell(npx playwright:*)",
